# ===========================================
# Enterprise RAG Agent - 环境变量配置模板
# ===========================================
# 使用方法：复制为 .env 后填入实际值
#   cp .env.example .env
#
# 注意：
# 1. 不要把真实密钥/密码提交到 Git
# 2. SECRET_KEY 必须替换为 >= 32 字符的随机串
#    可用 `openssl rand -hex 32` 或 `python -c "import secrets; print(secrets.token_hex(32))"` 生成
# ===========================================

# --- 应用配置 ---
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO

# --- 安全 ---
# JWT 签名密钥（生产环境必须修改！长度 >= 32）
SECRET_KEY=please-change-me-to-a-random-string-of-at-least-32-characters

# --- Milvus 向量数据库 ---
# 单机部署：docker compose -f milvus-standalone-docker-compose.yml up -d
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DB_NAME=default
MILVUS_COLLECTION_NAME=enterprise_docs
MILVUS_TOKEN=

# --- Embedding (Ollama) ---
# 安装：curl -fsSL https://ollama.com/install.sh | sh
# 拉取模型：ollama pull bge-m3
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
EMBED_DIM=1024

# --- LLM 配置 ---
# LLM_PROVIDER: "ollama" 或 "vllm"
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct

# vLLM 预留配置（切换为 vLLM 后端时使用）
VLLM_API_URL=
VLLM_MODEL=
VLLM_API_KEY=

# --- 百炼文档解析 Fallback（可选）---
# 当本地 unstructured 无法解析时，调用阿里云 DashScope (Kimi) API 兜底
# 不需要可留空
BAICHUAN_API_KEY=
BAICHUAN_MODEL=kimi-k2.6
BAICHUAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAICHUAN_MAX_FILE_SIZE=5242880

# --- 文档分块 ---
# 默认策略: auto/fixed_size/recursive/semantic/structured/parent_child/llm_smart
CHUNK_SIZE=512
CHUNK_OVERLAP=128
DEFAULT_CHUNK_STRATEGY=auto
CHUNK_PREVIEW_MAX_CHARS=30000

# 父子分块参数
PARENT_CHUNK_SIZE=2048
CHILD_CHUNK_SIZE=256
PARENT_CHUNK_OVERLAP=256
CHILD_CHUNK_OVERLAP=64

# LLM 智能分块
LLM_CHUNK_MODEL=kimi-k2.6
LLM_CHUNK_TEMPERATURE=0.3
LLM_CHUNK_MAX_TOKENS=4096

# --- 检索配置 ---
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_RERANK=5
RERANKER_MODEL=BAAI/bge-reranker-base

# --- 元数据库 ---
# 开发: sqlite+aiosqlite:///./metadata.db
# 生产: postgresql+asyncpg://rag:rag_password@localhost:5432/rag_metadata
METADATA_DB_URL=sqlite+aiosqlite:///./metadata.db

# --- Celery / Redis ---
# 异步任务队列，用于大文件文档处理
REDIS_URL=redis://localhost:6379/0
